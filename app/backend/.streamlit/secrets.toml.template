# Decksmith — Streamlit Cloud secrets template
#
# To deploy:
#   1. Copy this file to .streamlit/secrets.toml  (already in .gitignore)
#   2. Paste your keys below
#   3. OR paste into the Streamlit Cloud dashboard under App settings → Secrets
#
# Only one key is needed — whichever provider you want to offer.

[api_keys]
ANTHROPIC_API_KEY = ""   # get one at console.anthropic.com
OPENAI_API_KEY    = ""   # get one at platform.openai.com
